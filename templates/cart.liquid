{% layout 'theme' %}

<section class="section">
  <div class="container--narrow">
    <h1 style="font-family:var(--font-heading);font-size:clamp(1.8rem,3.5vw,3rem);margin-bottom:2.5rem;">Votre Panier</h1>

    {% if cart.item_count == 0 %}
      <div class="text-center" style="padding:4rem 0;">
        <p style="color:var(--color-text-muted);margin-bottom:2rem;">Votre panier est vide.</p>
        <a href="/collections/all" class="btn btn--outline">Continuer mes achats</a>
      </div>
    {% else %}
      <form action="/cart" method="post">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:2px solid var(--color-border);">
              <th style="text-align:left;padding:.75rem 0;font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;">Produit</th>
              <th style="text-align:center;padding:.75rem;font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;">Quantité</th>
              <th style="text-align:right;padding:.75rem 0;font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;">Total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr style="border-bottom:1px solid var(--color-border);">
                <td style="padding:1.5rem 0;">
                  <div style="display:flex;gap:1.25rem;align-items:center;">
                    <a href="{{ item.url }}" style="width:80px;height:80px;overflow:hidden;background:var(--color-surface);flex-shrink:0;">
                      {{ item | img_url: '160x160' | img_tag: item.product.title, 'loading="lazy"style="width:100%;height:100%;object-fit:cover;"' }}
                    </a>
                    <div>
                      <a href="{{ item.url }}" style="font-weight:500;display:block;margin-bottom:.25rem;">{{ item.product.title }}</a>
                      {% if item.variant.title != 'Default Title' %}
                        <div style="font-size:.8rem;color:var(--color-text-muted);">{{ item.variant.title }}</div>
                      {% endif %}
                      <div style="font-size:.85rem;margin-top:.25rem;">{{ item.price | money }}</div>
                    </div>
                  </div>
                </td>
                <td style="text-align:center;padding:1.5rem;">
                  <div style="display:flex;align-items:center;justify-content:center;border:1px solid var(--color-border);width:fit-content;margin:0 auto;">
                    <button type="button" style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;" onclick="this.closest('tr').querySelector('input').value = Math.max(1, parseInt(this.closest('tr').querySelector('input').value)-1)">−</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:48px;height:36px;text-align:center;border:none;border-left:1px solid var(--color-border);border-right:1px solid var(--color-border);font-size:.85rem;outline:none;">
                    <button type="button" style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;" onclick="this.closest('tr').querySelector('input').value = parseInt(this.closest('tr').querySelector('input').value)+1">+</button>
                  </div>
                </td>
                <td style="text-align:right;padding:1.5rem 0;font-weight:600;">{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;">
          <div style="min-width:300px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:.75rem;font-size:.9rem;">
              <span style="color:var(--color-text-muted);">Sous-total</span>
              <span style="font-weight:600;">{{ cart.total_price | money }}</span>
            </div>
            <div style="font-size:.75rem;color:var(--color-text-muted);margin-bottom:1.5rem;">Livraison calculée à la caisse</div>
            <div style="display:flex;gap:.75rem;flex-direction:column;">
              <button type="submit" name="update" class="btn btn--outline btn--full">Mettre à jour</button>
              <a href="/checkout" class="btn btn--primary btn--full btn--large">Commander →</a>
            </div>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>
