{% layout 'theme' %}

<section class="section">
  <div class="container--narrow">
    <div class="breadcrumb">
      <a href="/">Accueil</a>
      <span class="breadcrumb__sep">/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <span class="breadcrumb__sep">/</span>
      <span>{{ article.title | truncate: 40 }}</span>
    </div>

    {% if article.image %}
      {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: article.title, style: 'width:100%;aspect-ratio:16/7;object-fit:cover;margin-bottom:3rem;' }}
    {% endif %}

    <div style="text-align:center;margin-bottom:3rem;">
      <span style="font-size:.65rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--color-text-muted);">{{ article.published_at | date: '%d %B %Y' }}</span>
      <h1 style="font-family:var(--font-heading);font-size:clamp(1.8rem,4vw,3rem);margin:.75rem 0;">{{ article.title }}</h1>
    </div>

    <div style="font-size:.95rem;line-height:1.9;color:var(--color-text-muted);">{{ article.content }}</div>

    <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--color-border);text-align:center;">
      <a href="{{ blog.url }}" class="btn btn--outline">← Retour au blog</a>
    </div>
  </div>
</section>
