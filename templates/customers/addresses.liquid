{% layout 'theme' %}

<section class="section">
  <div class="container--narrow">
    <h1 style="font-family:var(--font-heading);font-size:2rem;margin-bottom:2.5rem;">Mes Adresses</h1>

    {% for address in customer.addresses %}
      <div style="border:1px solid var(--color-border);padding:1.5rem;margin-bottom:1.5rem;">
        {% if address == customer.default_address %}
          <span style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--color-accent);display:block;margin-bottom:.75rem;">Adresse principale</span>
        {% endif %}
        <p><strong>{{ address.first_name }} {{ address.last_name }}</strong></p>
        <p>{{ address.address1 }}{% if address.address2 %}, {{ address.address2 }}{% endif %}</p>
        <p>{{ address.city }}{% if address.zip %} {{ address.zip }}{% endif %}, {{ address.country }}</p>
      </div>
    {% else %}
      <p style="color:var(--color-text-muted);">Aucune adresse enregistrée.</p>
    {% endfor %}
  </div>
</section>
