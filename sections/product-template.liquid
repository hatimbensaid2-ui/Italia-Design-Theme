{% if section.settings.show_breadcrumb %}
  <div class="container">
    <div class="breadcrumb" style="padding-top:1.5rem;">
      <a href="/">Accueil</a>
      <span class="breadcrumb__sep">/</span>
      {% if product.collections.first %}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span class="breadcrumb__sep">/</span>
      {% endif %}
      <span>{{ product.title }}</span>
    </div>
  </div>
{% endif %}

<section class="product-page{% if section.settings.center_mobile %} product-page--center-mobile{% endif %}">
  <div class="container">
    <div class="product-layout">

      <!-- Gallery -->
      <div class="product-gallery">
        {% if product.images.size > 0 %}
          <div class="product-gallery__track" id="product-gallery-track">
            {% for image in product.images %}
              <div class="product-gallery__slide">
                {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="product-gallery__main"><div style="background:var(--color-surface);width:100%;aspect-ratio:4/5;"></div></div>
        {% endif %}
        {% if product.images.size > 1 %}
          <div class="product-gallery__thumbs">
            {% for image in product.images %}
              <div class="product-gallery__thumb{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
                {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: product.title }}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        {% if product.vendor != blank %}
          <div class="product-info__vendor">{{ product.vendor }}</div>
        {% endif %}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price-wrap">
          <span class="product-info__price price{% if product.compare_at_price > product.price %} price--sale{% endif %}">
            {{ product.price | money }}
          </span>
          {% if product.compare_at_price > product.price %}
            <span class="product-info__price--compare">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>

        <hr class="product-divider">

        <!-- Add to Cart Form -->
        <form action="/cart/add" method="post" class="product-add-form">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">

          <!-- Variant Options -->
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="product-option">
                <div class="product-option__label">
                  {{ option.name }}
                  <span class="product-option__selected">{{ option.selected_value }}</span>
                </div>
                <div class="variant-swatches">
                  {% for value in option.values %}
                    <button type="button" class="variant-swatch{% if option.selected_value == value %} active{% endif %}" data-value="{{ value }}" data-option-index="{{ forloop.parentloop.index0 }}">
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <!-- Quantity -->
          <div class="product-qty" style="margin-bottom:1.5rem;">
            <button type="button" class="product-qty__btn" aria-label="Diminuer">−</button>
            <input type="number" name="quantity" value="1" min="1" max="99" class="product-qty__input" readonly>
            <button type="button" class="product-qty__btn" aria-label="Augmenter">+</button>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn btn--primary btn--full" {% unless product.available %}disabled{% endunless %}>
            <span class="btn-text">{% if product.available %}Ajouter au panier{% else %}Épuisé{% endif %}</span>
            <span class="btn-loading"><div class="spinner"></div></span>
          </button>
        </form>

        <!-- Meta -->
        <div class="product-meta">
          {% if product.sku != blank %}
            <div class="product-meta__item">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
              <span>Référence : {{ product.variants.first.sku }}</span>
            </div>
          {% endif %}
          {% if section.settings.shipping_text != blank %}
            <div class="product-meta__item">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
              <span>{{ section.settings.shipping_text }}</span>
            </div>
          {% endif %}
          {% if section.settings.warranty_text != blank %}
            <div class="product-meta__item">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>{{ section.settings.warranty_text }}</span>
            </div>
          {% endif %}
        </div>

        <!-- Accordion -->
        <div class="product-accordion">
          {% if product.description != blank %}
            <div class="accordion-item">
              <button class="accordion-trigger" type="button">
                Description
                <span class="accordion-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
              </button>
              <div class="accordion-content">{{ product.description }}</div>
            </div>
          {% endif %}
          {% if section.settings.acc1_content != blank %}
            <div class="accordion-item">
              <button class="accordion-trigger" type="button">
                {{ section.settings.acc1_title | default: 'Dimensions & Matériaux' }}
                <span class="accordion-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
              </button>
              <div class="accordion-content">{{ section.settings.acc1_content }}</div>
            </div>
          {% endif %}
          {% if section.settings.acc2_content != blank %}
            <div class="accordion-item">
              <button class="accordion-trigger" type="button">
                {{ section.settings.acc2_title | default: 'Livraison & Montage' }}
                <span class="accordion-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
              </button>
              <div class="accordion-content">{{ section.settings.acc2_content }}</div>
            </div>
          {% endif %}
          {% if section.settings.acc3_content != blank %}
            <div class="accordion-item">
              <button class="accordion-trigger" type="button">
                {{ section.settings.acc3_title | default: 'Retours & Garantie' }}
                <span class="accordion-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
              </button>
              <div class="accordion-content">{{ section.settings.acc3_content }}</div>
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  window.productVariants = {{ product.variants | json }};
</script>

{% schema %}
{
  "name": "Produit",
  "settings": [
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Afficher le fil d'Ariane",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "center_mobile",
      "label": "Centrer le contenu sur mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Badges de confiance"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Texte livraison",
      "default": "Livraison gratuite partout au Maroc"
    },
    {
      "type": "text",
      "id": "warranty_text",
      "label": "Texte garantie",
      "default": "Garantie 5 ans fabricant"
    },
    {
      "type": "header",
      "content": "Accordéon 1"
    },
    {
      "type": "text",
      "id": "acc1_title",
      "label": "Titre",
      "default": "Dimensions & Matériaux"
    },
    {
      "type": "richtext",
      "id": "acc1_content",
      "label": "Contenu",
      "default": "<p>Consultez la fiche technique du produit ou contactez-nous pour obtenir les dimensions précises et les informations sur les matériaux utilisés.</p>"
    },
    {
      "type": "header",
      "content": "Accordéon 2"
    },
    {
      "type": "text",
      "id": "acc2_title",
      "label": "Titre",
      "default": "Livraison & Montage"
    },
    {
      "type": "richtext",
      "id": "acc2_content",
      "label": "Contenu",
      "default": "<p>Livraison gratuite dans tout le Maroc. Délai de livraison : 7 à 21 jours ouvrés selon votre région. Service de montage disponible sur demande.</p>"
    },
    {
      "type": "header",
      "content": "Accordéon 3"
    },
    {
      "type": "text",
      "id": "acc3_title",
      "label": "Titre",
      "default": "Retours & Garantie"
    },
    {
      "type": "richtext",
      "id": "acc3_content",
      "label": "Contenu",
      "default": "<p>Tous nos produits sont couverts par une garantie de 5 ans. En cas de défaut, nous nous engageons à réparer ou remplacer votre meuble.</p>"
    }
  ]
}
{% endschema %}
