<section class="section{% if section.settings.bg == 'surface' %} bg-surface{% endif %}">
  <div class="container">
    <div class="section-header reveal">
      {% if section.settings.overline != blank %}
        <span class="overline">{{ section.settings.overline }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="section-header__desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="collections-grid">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}
        <a href="{{ col.url | default: block.settings.url | default: '#' }}" class="collection-card{% if forloop.index == 1 and section.settings.first_featured %} collection-card--featured{% endif %} reveal" style="animation-delay:{{ forloop.index0 | times: 80 }}ms;">
          <div class="collection-card__media">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% elsif col.image %}
              {{ col.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: col.title }}
            {% else %}
              <div style="background:#f0f0f0;width:100%;height:100%;"></div>
            {% endif %}
          </div>
          <div class="collection-card__overlay"></div>
          <div class="collection-card__content">
            {% if block.settings.overline != blank %}
              <span class="overline" style="color:var(--color-accent);display:block;margin-bottom:.5rem;">{{ block.settings.overline }}</span>
            {% endif %}
            <h3 class="collection-card__title">{{ block.settings.title | default: col.title }}</h3>
            {% if col != blank %}
              <span class="collection-card__count">{{ col.all_products_count }} produits</span>
            {% endif %}
            <span class="collection-card__link">
              Découvrir
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.btn_text != blank %}
      <div class="text-center" style="margin-top:3rem;">
        <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn--outline">{{ section.settings.btn_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collections vedettes",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Nos Univers" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Explorez nos Collections" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Du salon à la chambre, découvrez des espaces conçus pour sublimer votre intérieur." },
    { "type": "checkbox", "id": "first_featured", "label": "Première collection en vedette", "default": false },
    { "type": "text", "id": "btn_text", "label": "Bouton texte", "default": "Toutes les Collections" },
    { "type": "url", "id": "btn_url", "label": "Bouton lien" },
    { "type": "select", "id": "bg", "label": "Fond", "options": [{"value":"white","label":"Blanc"},{"value":"surface","label":"Gris clair"}], "default": "white" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optionnel)" },
        { "type": "text", "id": "overline", "label": "Surtitre" },
        { "type": "text", "id": "title", "label": "Titre (optionnel)" },
        { "type": "url", "id": "url", "label": "Lien (si pas de collection)" }
      ]
    }
  ],
  "presets": [{
    "name": "Collections vedettes",
    "blocks": [
      { "type": "collection", "settings": { "title": "Salon", "overline": "Espace Détente" } },
      { "type": "collection", "settings": { "title": "Chambre", "overline": "Espace Nuit" } },
      { "type": "collection", "settings": { "title": "Salle à Manger", "overline": "Espace Repas" } }
    ]
  }]
}
{% endschema %}
