<section style="background:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;">
  <div class="container">
    <div style="display:grid;grid-template-columns:{% if section.settings.image_width == 'wide' %}3fr 2fr{% elsif section.settings.image_width == 'narrow' %}2fr 3fr{% else %}1fr 1fr{% endif %};gap:{{ section.settings.gap }}rem;align-items:center;">

      <div style="order:{% if section.settings.reverse %}2{% else %}1{% endif %};">
        {% if section.settings.image %}
          <div style="overflow:hidden;aspect-ratio:{{ section.settings.image_ratio | replace: '-', '/' }};">
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading, style: 'width:100%;height:100%;object-fit:cover;transition:transform .6s ease;' }}
          </div>
        {% endif %}
      </div>

      <div style="order:{% if section.settings.reverse %}1{% else %}2{% endif %};padding:{{ section.settings.content_padding }}rem 0;">
        {% if section.settings.overline != blank %}
          <span class="overline" style="display:block;margin-bottom:.75rem;color:{{ section.settings.accent_color }};">{{ section.settings.overline }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-family:var(--font-heading);font-size:{{ section.settings.heading_size }}px;color:{{ section.settings.text_color }};margin-bottom:1.25rem;font-weight:400;line-height:1.2;">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div style="font-size:.9rem;color:{{ section.settings.text_color }};opacity:.7;line-height:1.8;margin-bottom:2rem;">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_url }}" class="btn btn--{{ section.settings.btn_style }}">{{ section.settings.btn_text }}</a>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image avec texte",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_ratio", "label": "Format de l'image", "options": [{"value":"1-1","label":"Carré"},{"value":"4-5","label":"Portrait (4:5)"},{"value":"4-3","label":"Paysage (4:3)"},{"value":"3-2","label":"Photo (3:2)"}], "default": "4-3" },
    { "type": "text", "id": "overline", "label": "Surtitre" },
    { "type": "color", "id": "accent_color", "label": "Couleur surtitre", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 56, "step": 2, "default": 36, "label": "Taille du titre", "unit": "px" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "btn_text", "label": "Bouton — Texte" },
    { "type": "url", "id": "btn_url", "label": "Bouton — Lien" },
    { "type": "select", "id": "btn_style", "label": "Bouton — Style", "options": [{"value":"outline","label":"Contour"},{"value":"primary","label":"Plein"}], "default": "outline" },
    { "type": "select", "id": "image_width", "label": "Proportion image", "options": [{"value":"equal","label":"50/50"},{"value":"wide","label":"Image large (60%)"},{"value":"narrow","label":"Image étroite (40%)"}], "default": "equal" },
    { "type": "checkbox", "id": "reverse", "label": "Image à droite", "default": false },
    { "type": "range", "id": "gap", "min": 1, "max": 8, "step": 1, "default": 4, "label": "Espacement image/texte", "unit": "rem" },
    { "type": "range", "id": "content_padding", "min": 0, "max": 5, "step": 1, "default": 1, "label": "Padding vertical contenu", "unit": "rem" },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Couleur texte", "default": "#1a1a1a" },
    { "type": "range", "id": "padding_top", "min": 2, "max": 12, "step": 1, "default": 5, "label": "Espacement haut", "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "min": 2, "max": 12, "step": 1, "default": 5, "label": "Espacement bas", "unit": "rem" }
  ],
  "presets": [{ "name": "Image avec texte" }]
}
{% endschema %}
