<section class="section reels-section{% if section.settings.bg == 'surface' %} bg-surface{% endif %}">
  <div class="container">
    <div class="section-header reveal">
      {% if section.settings.overline != blank %}
        <span class="overline">{{ section.settings.overline }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="section-header__desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="reels-masonry">
      {% for block in section.blocks %}
        {% assign prod = all_products[block.settings.product] %}
        {% assign reel_url = block.settings.url | default: prod.url | default: '#' %}
        <a href="{{ reel_url }}" class="reel-item reveal" {{ block.shopify_attributes }}>
          <div class="reel-item__media">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.caption | default: prod.title }}
            {% elsif prod != blank and prod.featured_image %}
              {{ prod.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: prod.title }}
            {% else %}
              <div class="reel-item__placeholder"></div>
            {% endif %}
            {% if prod != blank or block.settings.caption != blank %}
              <div class="reel-item__overlay">
                <span class="reel-item__name">{{ block.settings.caption | default: prod.title }}</span>
                {% if prod != blank %}
                  <span class="reel-item__price">{{ prod.price | money }}</span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Photos Reeles",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Inspirations" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Photos Reeles" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "select", "id": "bg", "label": "Fond", "options": [{"value":"white","label":"Blanc"},{"value":"surface","label":"Gris clair"}], "default": "white" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "product", "id": "product", "label": "Produit lié" },
        { "type": "text", "id": "caption", "label": "Légende (optionnel, remplace le nom du produit)" },
        { "type": "url", "id": "url", "label": "Lien personnalisé (si pas de produit)" }
      ]
    }
  ],
  "presets": [{
    "name": "Photos Reeles",
    "blocks": [
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" }
    ]
  }]
}
{% endschema %}
