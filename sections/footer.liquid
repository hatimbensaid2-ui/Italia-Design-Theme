<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand Column -->
      <div class="footer-brand">
        <div class="footer-brand__logo">
          {% assign footer_logo = section.settings.logo_image | default: settings.logo %}
          {% if footer_logo %}
            {{ footer_logo | image_url: width: 240 | image_tag: alt: shop.name, style: 'filter:brightness(0)invert(1);max-width:' | append: section.settings.logo_width | append: 'px;margin-bottom:1.25rem;' }}
          {% else %}
            {{ section.settings.logo_text | default: settings.logo_text | default: shop.name | upcase }}
          {% endif %}
        </div>
        {% assign about = section.settings.about_text | default: settings.footer_about %}
        <div class="footer-brand__desc">{{ about }}</div>
        <div class="footer-social">
          {% if settings.social_instagram != blank %}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {% endif %}
          {% if settings.social_facebook != blank %}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
          {% endif %}
          {% if settings.social_tiktok != blank %}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.17 8.17 0 004.78 1.52V6.74a4.85 4.85 0 01-1.01-.05z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Navigation -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col1_title | default: 'Navigation' }}</h3>
        <ul class="footer-col__links">
          {% if linklists[section.settings.menu].links.size > 0 %}
            {% for link in linklists[section.settings.menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.root_url }}">Accueil</a></li>
            <li><a href="/collections/all">Collections</a></li>
            <li><a href="/pages/about">À propos</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Info -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col2_title | default: 'Informations' }}</h3>
        <ul class="footer-col__links">
          {% if linklists[section.settings.menu2].links.size > 0 %}
            {% for link in linklists[section.settings.menu2].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/policies/shipping-policy">Livraison</a></li>
            <li><a href="/policies/refund-policy">Retours</a></li>
            <li><a href="/policies/privacy-policy">Confidentialité</a></li>
            <li><a href="/policies/terms-of-service">Conditions</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col3_title | default: 'Contact' }}</h3>
        {% assign f_address = section.settings.address | default: settings.footer_address %}
        {% assign f_phone = section.settings.phone | default: settings.footer_phone %}
        {% assign f_email = section.settings.email | default: settings.footer_email %}
        {% if f_address != blank %}
          <div class="footer-contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>{{ f_address }}</span>
          </div>
        {% endif %}
        {% if f_phone != blank %}
          <div class="footer-contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span><a href="tel:{{ f_phone | remove: ' ' }}" style="color:inherit;">{{ f_phone }}</a></span>
          </div>
        {% endif %}
        {% if f_email != blank %}
          <div class="footer-contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span><a href="mailto:{{ f_email }}" style="color:inherit;">{{ f_email }}</a></span>
          </div>
        {% endif %}
        {% if section.settings.show_hours %}
          <div style="margin-top:1.5rem;">
            <p style="font-size:.65rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:.75rem;">Horaires</p>
            <p style="font-size:.8rem;color:rgba(255,255,255,.4);line-height:1.6;">
              Lun – Ven : {{ section.settings.hours_weekday | default: '9h – 18h' }}<br>
              Samedi : {{ section.settings.hours_saturday | default: '9h – 12h' }}
              {%- if section.settings.hours_sunday != blank %}<br>Dimanche : {{ section.settings.hours_sunday }}{%- endif %}
            </p>
          </div>
        {% endif %}
      </div>

    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p>
      <div class="footer-payments">
        <span class="payment-icon">VISA</span>
        <span class="payment-icon">MC</span>
        <span class="payment-icon">CMI</span>
        <span class="payment-icon">COD</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "header",
      "content": "Logo / Marque"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo (image)",
      "info": "Téléchargez votre logo. Il sera affiché en blanc sur le fond sombre."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Largeur du logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texte du logo (si pas d'image)",
      "info": "Laissez vide pour utiliser le logo global du thème."
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "Texte de présentation"
    },
    {
      "type": "header",
      "content": "Colonne 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Titre",
      "default": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Colonne 2"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Titre",
      "default": "Informations"
    },
    {
      "type": "link_list",
      "id": "menu2",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Colonne 3 — Contact"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Titre",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adresse"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "header",
      "content": "Horaires"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Afficher les horaires",
      "default": true
    },
    {
      "type": "text",
      "id": "hours_weekday",
      "label": "Lundi – Vendredi",
      "default": "9h – 18h"
    },
    {
      "type": "text",
      "id": "hours_saturday",
      "label": "Samedi",
      "default": "9h – 12h"
    },
    {
      "type": "text",
      "id": "hours_sunday",
      "label": "Dimanche (vide si fermé)"
    }
  ]
}
{% endschema %}
