<section class="section{% if section.settings.bg == 'surface' %} bg-surface{% endif %}">
  <div class="container">
    <div class="section-header reveal">
      {% if section.settings.overline != blank %}
        <span class="overline">{{ section.settings.overline }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="section-header__desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% assign col = collections[section.settings.collection] %}
    {% if section.settings.collection != blank and col != blank %}
      {% assign products_list = col.products | limit: section.settings.products_count %}
    {% else %}
      {% assign products_list = section.blocks %}
    {% endif %}

    <div class="grid grid--4 reveal">
      {% for item in products_list limit: section.settings.products_count %}
        {% if section.settings.collection != blank %}
          {% assign product = item %}
        {% else %}
          {% assign product = item.settings.product %}
        {% endif %}
        {% if product %}
          <div class="product-card" style="animation-delay:{{ forloop.index0 | times: 60 }}ms;">
            <div class="product-card__media">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <div style="background:var(--color-surface);width:100%;height:100%;"></div>
                {% endif %}
                {% if product.images[1] %}
                  <div class="product-card__media-secondary">
                    {{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                  </div>
                {% endif %}
              </a>

              <div class="product-card__badges">
                {% if product.available == false %}
                  <span class="badge badge--sold">Épuisé</span>
                {% endif %}
                {% if product.compare_at_price > product.price %}
                  {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="badge badge--sale">-{{ discount }}%</span>
                {% endif %}
              </div>

              <div class="product-card__actions">
                <button class="product-card__quick-add" data-product-id="{{ product.variants.first.id }}" onclick="CartDrawer.addItem({{ product.variants.first.id }})">
                  Ajouter au panier
                </button>
              </div>
            </div>

            <div class="product-card__info">
              {% if product.vendor != blank %}
                <div class="product-card__vendor">{{ product.vendor }}</div>
              {% endif %}
              <h3 class="product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="product-card__price">
                <span class="price{% if product.compare_at_price > product.price %} price--sale{% endif %}">
                  {{ product.price | money }}
                </span>
                {% if product.compare_at_price > product.price %}
                  <span class="price price--compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.btn_text != blank %}
      <div class="text-center" style="margin-top:3rem;">
        <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn--outline">{{ section.settings.btn_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Produits vedettes",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Sélection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Pièces Coup de Cœur" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "collection", "id": "collection", "label": "Collection source (optionnel)" },
    { "type": "range", "id": "products_count", "min": 2, "max": 8, "step": 1, "default": 4, "label": "Nombre de produits" },
    { "type": "text", "id": "btn_text", "label": "Bouton texte", "default": "Voir Tout" },
    { "type": "url", "id": "btn_url", "label": "Bouton lien" },
    { "type": "select", "id": "bg", "label": "Fond", "options": [{"value":"white","label":"Blanc"},{"value":"surface","label":"Gris clair"}], "default": "white" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" }
      ]
    }
  ],
  "presets": [{ "name": "Produits vedettes" }]
}
{% endschema %}
