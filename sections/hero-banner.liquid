<section class="hero{% if section.settings.full_height %} hero--full{% endif %}{% if section.settings.video_display == 'letterbox' and section.settings.hero_video != blank %} hero--video-letterbox{% endif %}" style="{% unless section.settings.video_display == 'letterbox' and section.settings.hero_video != blank %}min-height:{{ section.settings.min_height }}vh;{% endunless %}">

  <div class="hero__media">
    {% if section.settings.hero_video != blank %}
      {% assign vid = section.settings.hero_video %}
      {% assign vid_class = 'hero__video-embed' %}
      {% if section.settings.video_display == 'letterbox' %}{% assign vid_class = 'hero__video-embed hero__video-embed--letterbox' %}{% endif %}
      {% if vid.type == 'youtube' %}
        {% assign yt_start = section.settings.video_start | default: 0 %}
        {% comment %} No loop/playlist params — the IFrame API below handles looping, which avoids YouTube's prev/next controls {% endcomment %}
        {% assign yt_src = 'https://www.youtube.com/embed/' | append: vid.id | append: '?autoplay=1&mute=1&controls=0&showinfo=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3&cc_load_policy=0&fs=0&color=white&enablejsapi=1&origin=' | append: request.origin | append: '&start=' | append: yt_start %}
        <iframe id="hero-yt-{{ section.id }}"
          class="{{ vid_class }}"
          data-hero-yt
          data-yt-id="{{ vid.id }}"
          data-yt-start="{{ yt_start }}"
          data-yt-end="{{ section.settings.video_end | default: 0 }}"
          src="{{ yt_src }}"
          frameborder="0" allow="autoplay; encrypted-media"
          title="{{ section.settings.heading | escape }}"></iframe>
        <div class="hero__video-cover" aria-hidden="true"></div>
      {% elsif vid.type == 'vimeo' %}
        {% assign vm_src = 'https://player.vimeo.com/video/' | append: vid.id | append: '?autoplay=1&muted=1&loop=1&background=1' %}
        {% if section.settings.video_start != blank %}{% assign vm_src = vm_src | append: '#t=' | append: section.settings.video_start | append: 's' %}{% endif %}
        <iframe class="{{ vid_class }}"
          src="{{ vm_src }}"
          frameborder="0" allow="autoplay; fullscreen" allowfullscreen
          title="{{ section.settings.heading | escape }}"></iframe>
      {% endif %}
    {% elsif section.settings.video_url != blank %}
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.image %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', alt: section.settings.heading }}
    {% else %}
      <div style="position:absolute;inset:0;background:linear-gradient(135deg,#1a1a1a 0%,#2d2d2d 100%);"></div>
    {% endif %}
  </div>

  <div class="hero__overlay" style="background:{{ section.settings.overlay_color }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="container">
    <div class="hero__content{% if section.settings.alignment == 'left' %} hero__content--left{% endif %}">
      {% if section.settings.overline != blank %}
        <span class="overline hero__overline">{{ section.settings.overline }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="hero__actions">
        {% if section.settings.btn1_text != blank %}
          <a href="{{ section.settings.btn1_url }}" class="btn btn--primary btn--large">{{ section.settings.btn1_text }}</a>
        {% endif %}
        {% if section.settings.btn2_text != blank %}
          <a href="{{ section.settings.btn2_url }}" class="btn btn--secondary btn--large">{{ section.settings.btn2_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_scroll %}
    <div class="hero__scroll">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/></svg>
    </div>
  {% endif %}

</section>

{% if section.settings.hero_video != blank and vid.type == 'youtube' %}
<script>
(function () {
  var iframe = document.getElementById('hero-yt-{{ section.id }}');
  if (!iframe) return;
  var start = parseFloat(iframe.dataset.ytStart) || 0;
  var end = parseFloat(iframe.dataset.ytEnd) || 0;

  function loadApi(cb) {
    if (window.YT && window.YT.Player) { cb(); return; }
    window.__heroYtCallbacks = window.__heroYtCallbacks || [];
    window.__heroYtCallbacks.push(cb);
    if (!document.getElementById('yt-iframe-api')) {
      var tag = document.createElement('script');
      tag.id = 'yt-iframe-api';
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
    }
    var prev = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = function () {
      if (typeof prev === 'function') prev();
      (window.__heroYtCallbacks || []).forEach(function (fn) { fn(); });
      window.__heroYtCallbacks = [];
    };
  }

  loadApi(function () {
    var player = new YT.Player(iframe.id, {
      events: {
        onReady: function (e) {
          e.target.mute();
          e.target.playVideo();
          // Keep the trimmed segment looping AND never let it sit paused
          setInterval(function () {
            try {
              var state = player.getPlayerState();
              // -1 unstarted, 2 paused, 5 cued → force play so the center play/pause button never shows
              if (state === 2 || state === 5 || state === -1) {
                player.mute();
                player.playVideo();
              }
              var t = player.getCurrentTime();
              if (end > start && t >= end - 0.25) { player.seekTo(start, true); }
            } catch (err) {}
          }, 200);
        },
        onStateChange: function (e) {
          // Resume immediately on end or pause so YouTube's center button never appears
          if (e.data === YT.PlayerState.ENDED) { player.seekTo(start, true); player.playVideo(); }
          if (e.data === YT.PlayerState.PAUSED) { player.playVideo(); }
        }
      }
    });
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Bannière héro",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video_url", "id": "hero_video", "accept": ["youtube", "vimeo"], "label": "Vidéo YouTube / Vimeo", "info": "Collez le lien YouTube ou Vimeo. La vidéo s'affiche en fond, en lecture automatique et muette." },
    { "type": "select", "id": "video_display", "label": "Mode d'affichage vidéo", "options": [{"value":"cover","label":"Plein écran (recadré)"},{"value":"letterbox","label":"Mode horizontal — H (sans recadrage)"}], "default": "cover" },
    { "type": "number", "id": "video_start", "label": "Début vidéo (secondes)", "info": "Laissez vide pour commencer au début (YouTube uniquement)." },
    { "type": "number", "id": "video_end", "label": "Fin vidéo (secondes)", "info": "Laissez vide pour aller jusqu'à la fin (YouTube uniquement)." },
    { "type": "text", "id": "video_url", "label": "URL vidéo (.mp4)", "info": "Alternative : lien direct vers un fichier .mp4." },
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Collection 2025" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "L'Art du\nMobilier Italien" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Découvrez notre collection exclusive de meubles de luxe — élégance intemporelle, artisanat d'exception." },
    { "type": "text", "id": "btn1_text", "label": "Bouton 1 texte", "default": "Explorer la Collection" },
    { "type": "url", "id": "btn1_url", "label": "Bouton 1 lien" },
    { "type": "text", "id": "btn2_text", "label": "Bouton 2 texte", "default": "Notre Showroom" },
    { "type": "url", "id": "btn2_url", "label": "Bouton 2 lien" },
    { "type": "select", "id": "alignment", "label": "Alignement", "options": [{"value":"center","label":"Centre"},{"value":"left","label":"Gauche"}], "default": "center" },
    { "type": "color", "id": "overlay_color", "label": "Couleur overlay", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "default": 45, "label": "Opacité overlay", "unit": "%" },
    { "type": "range", "id": "min_height", "min": 50, "max": 100, "step": 5, "default": 85, "label": "Hauteur minimale", "unit": "vh" },
    { "type": "checkbox", "id": "full_height", "label": "Pleine hauteur", "default": false },
    { "type": "checkbox", "id": "show_scroll", "label": "Indicateur de défilement", "default": true }
  ],
  "presets": [{ "name": "Bannière héro" }]
}
{% endschema %}
