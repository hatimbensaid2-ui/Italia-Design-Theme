<section style="min-height:{{ section.settings.min_height }}vh;display:flex;align-items:center;justify-content:center;text-align:center;background:{{ section.settings.bg_color }};padding:4rem 2rem;">
  <div>
    {% if section.settings.overline != blank %}
      <p class="overline" style="margin-bottom:1.25rem;color:{{ section.settings.accent_color }};">{{ section.settings.overline }}</p>
    {% endif %}
    <h1 style="font-family:var(--font-heading);font-size:clamp(2.5rem,7vw,5rem);margin-bottom:1.25rem;font-weight:300;color:{{ section.settings.text_color }};">{{ section.settings.heading }}</h1>
    <p style="color:{{ section.settings.text_color }};opacity:.6;margin-bottom:2.5rem;font-size:.95rem;">{{ section.settings.subtext }}</p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href="{{ section.settings.btn1_url | default: '/' }}" class="btn btn--primary">{{ section.settings.btn1_text }}</a>
      <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="btn btn--outline">{{ section.settings.btn2_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page 404",
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Erreur 404" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Page introuvable" },
    { "type": "textarea", "id": "subtext", "label": "Texte", "default": "La page que vous recherchez n'existe pas ou a été déplacée." },
    { "type": "text", "id": "btn1_text", "label": "Bouton 1 — Texte", "default": "Accueil" },
    { "type": "url", "id": "btn1_url", "label": "Bouton 1 — Lien" },
    { "type": "text", "id": "btn2_text", "label": "Bouton 2 — Texte", "default": "Voir nos produits" },
    { "type": "url", "id": "btn2_url", "label": "Bouton 2 — Lien" },
    { "type": "range", "id": "min_height", "min": 40, "max": 100, "step": 5, "default": 65, "label": "Hauteur minimale", "unit": "vh" },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Couleur texte", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Couleur surtitre", "default": "#c9a96e" }
  ],
  "presets": [{ "name": "Page 404" }]
}
{% endschema %}
