<header class="site-header{% if settings.sticky_header %} sticky{% endif %}"
  {% if section.settings.transparent_on_hero %}data-transparent{% endif %}
  role="banner">
  <div class="header-inner">

    <!-- Left Nav -->
    <nav class="header-nav" aria-label="Navigation principale">
      {% for link in linklists.main-menu.links limit: 3 %}
        <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    </nav>

    <!-- Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% if settings.logo %}
          {{ settings.logo | image_url: width: settings.logo_width | image_tag: loading: 'eager', alt: shop.name, class: 'header-logo__img', style: 'max-width:' | append: settings.logo_width | append: 'px;' }}
        {% else %}
          <span class="header-logo-text">{{ shop.name | upcase }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Right Actions -->
    <div class="header-actions">
      {% for link in linklists.main-menu.links offset: 3 limit: 2 %}
        <a href="{{ link.url }}" class="header-nav" style="font-size:.7rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;">{{ link.title }}</a>
      {% endfor %}

      <button class="header-icon-btn" data-search-open aria-label="Rechercher">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>

      <a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="Mon compte">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </a>

      <button class="header-icon-btn" data-cart-open aria-label="Panier ({{ cart.item_count }} articles)">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 7H4l1-7z"/></svg>
        <span class="cart-count" {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </button>

      <button class="mobile-menu-btn" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_hero",
      "label": "Transparent sur la bannière hero",
      "info": "L'en-tête commence transparent avec texte blanc, puis devient blanc au défilement.",
      "default": true
    }
  ]
}
{% endschema %}
