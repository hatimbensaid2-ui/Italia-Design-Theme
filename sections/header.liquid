<header class="site-header{% if section.settings.transparent_on_hero and template == 'index' %} site-header--transparent{% endif %}" role="banner">
  <div class="header-inner">

    <!-- Hamburger — left on mobile, hidden on desktop -->
    <button class="mobile-menu-btn" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <!-- Logo (left on desktop, center on mobile) -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% assign logo_dark = section.settings.logo_dark | default: settings.logo %}
        {% assign logo_light = section.settings.logo_light | default: logo_dark %}
        {% assign logo_w = section.settings.logo_width | default: 160 %}
        {% if logo_dark or logo_light %}
          {% capture logo_style %}max-width:{{ logo_w }}px;height:auto;{% endcapture %}
          {% if logo_light %}
            {{ logo_light | image_url: width: logo_w | image_tag: loading: 'eager', alt: shop.name, class: 'header-logo__img header-logo__light', style: logo_style }}
          {% endif %}
          {% if logo_dark %}
            {{ logo_dark | image_url: width: logo_w | image_tag: loading: 'eager', alt: shop.name, class: 'header-logo__img header-logo__dark', style: logo_style }}
          {% endif %}
        {% else %}
          <span class="header-logo-text">{{ section.settings.logo_text | default: shop.name | upcase }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Nav (desktop only) -->
    <nav class="header-nav" aria-label="Navigation principale">
      {% assign nav_menu = section.settings.menu | default: 'main-menu' %}
      {% for link in linklists[nav_menu].links %}
        {% if link.links.size > 0 %}
          <div class="header-nav__item header-nav__item--has-dropdown">
            <a href="{{ link.url }}"{% if link.active or link.child_active %} class="active"{% endif %}>
              {{ link.title }}
              <svg class="header-nav__caret" xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
            </a>
            <div class="header-dropdown">
              <ul class="header-dropdown__list">
                {% for child in link.links %}
                  <li><a href="{{ child.url }}"{% if child.active %} class="active"{% endif %}>{{ child.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        {% else %}
          <a class="header-nav__item" href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- Actions (right) — cart always visible; search & account desktop only -->
    <div class="header-actions">
      {% if section.settings.show_search %}
        <button class="header-icon-btn header-icon-btn--desktop" data-search-open aria-label="Rechercher">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      {% endif %}
      {% if section.settings.show_account %}
        <a href="{{ routes.account_url }}" class="header-icon-btn header-icon-btn--desktop" aria-label="Mon compte">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </a>
      {% endif %}
      <button class="header-icon-btn" data-cart-open aria-label="Panier ({{ cart.item_count }} articles)">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 7H4l1-7z"/></svg>
        <span class="cart-count" {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Logo blanc (en-tête transparent)",
      "info": "Affiché en haut de la page d'accueil, sur la bannière. Utilisez un logo blanc."
    },
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Logo noir (en-tête blanc / au défilement)",
      "info": "Affiché sur les autres pages et quand l'en-tête devient blanc au défilement. Utilisez un logo noir."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "default": 160,
      "unit": "px",
      "label": "Largeur du logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texte du logo (si pas d'image)",
      "default": "ITALIA DESIGN"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Icônes"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la recherche",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Afficher le compte client",
      "default": true
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_hero",
      "label": "Transparent sur la bannière hero",
      "info": "L'en-tête commence transparent avec texte blanc, puis devient blanc au défilement.",
      "default": true
    }
  ]
}
{% endschema %}
