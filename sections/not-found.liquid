<section class="section" style="min-height:{{ section.settings.min_height }}vh;display:flex;align-items:center;justify-content:center;text-align:center;background:{{ section.settings.bg_color }};">
  <div class="container container--narrow">
    {% if section.settings.overline != blank %}
      <p class="overline" style="margin-bottom:1rem;color:{{ section.settings.accent_color }};">{{ section.settings.overline }}</p>
    {% endif %}
    <h1 style="font-family:var(--font-heading);font-size:clamp(2.5rem,7vw,6rem);margin-bottom:1.25rem;color:{{ section.settings.text_color }};line-height:1;">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p style="color:{{ section.settings.text_color }};opacity:.7;margin-bottom:2.5rem;font-size:1rem;">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.show_search %}
      <form action="/search" method="get" role="search" style="max-width:440px;margin:0 auto 2.5rem;display:flex;border:1px solid var(--color-border);">
        <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" style="flex:1;padding:.9rem 1rem;border:none;outline:none;font-size:.85rem;background:transparent;color:{{ section.settings.text_color }};">
        <button type="submit" style="padding:0 1.25rem;background:var(--color-primary);color:var(--color-secondary);" aria-label="Rechercher">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </form>
    {% endif %}

    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      {% if section.settings.btn1_text != blank %}
        <a href="{{ section.settings.btn1_url | default: '/' }}" class="btn btn--primary">{{ section.settings.btn1_text }}</a>
      {% endif %}
      {% if section.settings.btn2_text != blank %}
        <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="btn btn--outline">{{ section.settings.btn2_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page 404",
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Erreur 404" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Page introuvable" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "La page que vous recherchez n'existe pas ou a été déplacée. Utilisez la recherche ou revenez à l'accueil." },
    { "type": "checkbox", "id": "show_search", "label": "Afficher la recherche", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder recherche", "default": "Rechercher des meubles…" },
    { "type": "text", "id": "btn1_text", "label": "Bouton 1 — Texte", "default": "Retour à l'accueil" },
    { "type": "url", "id": "btn1_url", "label": "Bouton 1 — Lien" },
    { "type": "text", "id": "btn2_text", "label": "Bouton 2 — Texte", "default": "Voir nos produits" },
    { "type": "url", "id": "btn2_url", "label": "Bouton 2 — Lien" },
    { "type": "header", "content": "Couleurs & mise en page" },
    { "type": "range", "id": "min_height", "min": 40, "max": 90, "step": 5, "default": 65, "label": "Hauteur minimale", "unit": "vh" },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent (surtitre)", "default": "#c9a96e" }
  ]
}
{% endschema %}
