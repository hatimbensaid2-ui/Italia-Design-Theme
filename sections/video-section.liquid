{% assign bg = section.settings.bg_color | default: '#000' %}
<section style="position:relative;overflow:hidden;background:{{ bg }};">
  <div style="{% if section.settings.contained %}max-width:1440px;margin:0 auto;padding:{{ section.settings.padding }}rem 2rem;{% else %}padding:0;{% endif %}">
    <div style="position:relative;{% if section.settings.aspect == '16-9' %}aspect-ratio:16/9;{% elsif section.settings.aspect == '4-3' %}aspect-ratio:4/3;{% elsif section.settings.aspect == '1-1' %}aspect-ratio:1;{% else %}min-height:{{ section.settings.height }}vh;{% endif %}overflow:hidden;">

      {% if section.settings.video_url != blank %}
        <video autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {% elsif section.settings.youtube_id != blank %}
        <iframe src="https://www.youtube.com/embed/{{ section.settings.youtube_id }}?autoplay={{ section.settings.autoplay | default: 0 }}&mute=1&loop=1&playlist={{ section.settings.youtube_id }}&controls={{ section.settings.show_controls | default: 0 }}" frameborder="0" allow="autoplay;encrypted-media" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:none;"></iframe>
      {% elsif section.settings.image %}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.heading, style: 'width:100%;height:100%;object-fit:cover;position:absolute;inset:0;' }}
      {% else %}
        <div style="position:absolute;inset:0;background:#1a1a1a;"></div>
      {% endif %}

      {% if section.settings.overlay_opacity > 0 %}
        <div style="position:absolute;inset:0;background:{{ section.settings.overlay_color | default: '#000' }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};pointer-events:none;"></div>
      {% endif %}

      {% if section.settings.show_content %}
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:3rem 2rem;z-index:2;">
          {% if section.settings.overline != blank %}
            <span class="overline" style="display:block;margin-bottom:1rem;color:var(--color-accent);">{{ section.settings.overline }}</span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 style="font-family:var(--font-heading);font-size:clamp(2rem,6vw,5rem);color:#fff;margin-bottom:1rem;font-weight:300;line-height:1.1;">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.btn_text != blank %}
            <a href="{{ section.settings.btn_url }}" class="btn btn--secondary btn--large" style="margin-top:1.5rem;">{{ section.settings.btn_text }}</a>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Section vidéo",
  "settings": [
    {
      "type": "header",
      "content": "Vidéo"
    },
    { "type": "text", "id": "video_url", "label": "URL vidéo .mp4", "info": "URL directe vers un fichier vidéo .mp4" },
    { "type": "text", "id": "youtube_id", "label": "ID YouTube", "info": "Ex: dQw4w9WgXcQ (la partie après v=)" },
    { "type": "image_picker", "id": "image", "label": "Image (si pas de vidéo)" },
    {
      "type": "header",
      "content": "Contenu superposé"
    },
    { "type": "checkbox", "id": "show_content", "label": "Afficher du texte sur la vidéo", "default": false },
    { "type": "text", "id": "overline", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "text", "id": "btn_text", "label": "Bouton — Texte" },
    { "type": "url", "id": "btn_url", "label": "Bouton — Lien" },
    {
      "type": "header",
      "content": "Mise en page"
    },
    { "type": "select", "id": "aspect", "label": "Format", "options": [{"value":"16-9","label":"16:9"},{"value":"4-3","label":"4:3"},{"value":"1-1","label":"Carré"},{"value":"custom","label":"Hauteur personnalisée"}], "default": "16-9" },
    { "type": "range", "id": "height", "min": 40, "max": 100, "step": 5, "default": 70, "label": "Hauteur (si format perso)", "unit": "vh" },
    { "type": "checkbox", "id": "contained", "label": "Contenu dans le container", "default": false },
    { "type": "range", "id": "padding", "min": 0, "max": 8, "step": 1, "default": 0, "label": "Padding vertical", "unit": "rem" },
    {
      "type": "header",
      "content": "Overlay"
    },
    { "type": "color", "id": "overlay_color", "label": "Couleur overlay", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "default": 0, "label": "Opacité overlay", "unit": "%" },
    { "type": "color", "id": "bg_color", "label": "Fond de section", "default": "#000000" }
  ],
  "presets": [
    { "name": "Section vidéo" }
  ]
}
{% endschema %}
