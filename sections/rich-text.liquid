<section class="section{% if section.settings.bg == 'dark' %} bg-dark{% elsif section.settings.bg == 'surface' %} bg-surface{% endif %}">
  <div class="container--narrow text-center">
    {% if section.settings.overline != blank %}
      <span class="overline" style="display:block;margin-bottom:1rem;">{{ section.settings.overline }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 style="font-family:var(--font-heading);font-size:clamp(1.8rem,3.5vw,3rem);margin-bottom:1.5rem;">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div style="font-size:.95rem;line-height:1.8;color:var(--color-text-muted);margin-bottom:2.5rem;">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_url }}" class="btn btn--outline">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "btn_text", "label": "Bouton texte" },
    { "type": "url", "id": "btn_url", "label": "Bouton lien" },
    { "type": "select", "id": "bg", "label": "Fond", "options": [{"value":"white","label":"Blanc"},{"value":"surface","label":"Gris clair"},{"value":"dark","label":"Sombre"}], "default": "white" }
  ],
  "presets": [{ "name": "Texte enrichi" }]
}
{% endschema %}
