<section style="background:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;">
  <div style="max-width:{{ section.settings.max_width }}px;margin:0 auto;padding:0 2rem;text-align:{{ section.settings.text_align }};">
    {% if section.settings.overline != blank %}
      <span class="overline" style="display:block;margin-bottom:1rem;color:{{ section.settings.accent_color }};">{{ section.settings.overline }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 style="font-family:var(--font-heading);font-size:{{ section.settings.heading_size }}px;color:{{ section.settings.text_color }};margin-bottom:1.25rem;font-weight:400;line-height:1.2;">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div style="font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};opacity:.75;line-height:1.8;margin-bottom:{% if section.settings.btn_text != blank %}2.5rem{% else %}0{% endif %};">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.btn_text != blank %}
      <div style="display:flex;gap:1rem;justify-content:{{ section.settings.text_align | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' | replace: 'center', 'center' }};flex-wrap:wrap;">
        <a href="{{ section.settings.btn_url }}" class="btn btn--{{ section.settings.btn_style }}">{{ section.settings.btn_text }}</a>
        {% if section.settings.btn2_text != blank %}
          <a href="{{ section.settings.btn2_url }}" class="btn btn--{{ section.settings.btn2_style }}">{{ section.settings.btn2_text }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre" },
    { "type": "color", "id": "accent_color", "label": "Couleur surtitre", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 72, "step": 2, "default": 48, "label": "Taille du titre", "unit": "px" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "range", "id": "text_size", "min": 13, "max": 22, "step": 1, "default": 16, "label": "Taille du texte", "unit": "px" },
    { "type": "text", "id": "btn_text", "label": "Bouton 1 — Texte" },
    { "type": "url", "id": "btn_url", "label": "Bouton 1 — Lien" },
    { "type": "select", "id": "btn_style", "label": "Bouton 1 — Style", "options": [{"value":"outline","label":"Contour"},{"value":"primary","label":"Plein"},{"value":"accent","label":"Doré"}], "default": "outline" },
    { "type": "text", "id": "btn2_text", "label": "Bouton 2 — Texte (optionnel)" },
    { "type": "url", "id": "btn2_url", "label": "Bouton 2 — Lien" },
    { "type": "select", "id": "btn2_style", "label": "Bouton 2 — Style", "options": [{"value":"outline","label":"Contour"},{"value":"primary","label":"Plein"},{"value":"accent","label":"Doré"}], "default": "outline" },
    { "type": "select", "id": "text_align", "label": "Alignement", "options": [{"value":"center","label":"Centré"},{"value":"left","label":"Gauche"},{"value":"right","label":"Droite"}], "default": "center" },
    { "type": "range", "id": "max_width", "min": 480, "max": 1440, "step": 80, "default": 720, "label": "Largeur maximale", "unit": "px" },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Couleur texte", "default": "#1a1a1a" },
    { "type": "range", "id": "padding_top", "min": 2, "max": 12, "step": 1, "default": 5, "label": "Espacement haut", "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "min": 2, "max": 12, "step": 1, "default": 5, "label": "Espacement bas", "unit": "rem" }
  ],
  "presets": [{ "name": "Texte enrichi" }]
}
{% endschema %}
