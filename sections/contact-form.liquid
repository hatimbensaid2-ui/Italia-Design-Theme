<section style="background:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;">
  <div class="container">
    <div style="display:grid;grid-template-columns:{% if section.settings.layout == 'with-info' %}1fr 1.5fr{% else %}1fr{% endif %};gap:5rem;align-items:start;{% if section.settings.layout == 'centered' %}max-width:680px;margin:0 auto;{% endif %}">

      {% if section.settings.layout == 'with-info' %}
        <div>
          {% if section.settings.overline != blank %}
            <span class="overline" style="display:block;margin-bottom:.75rem;">{{ section.settings.overline }}</span>
          {% endif %}
          <h2 style="font-family:var(--font-heading);font-size:clamp(1.8rem,3vw,2.8rem);margin-bottom:1.25rem;color:{{ section.settings.text_color }};">{{ section.settings.title | default: 'Contactez-nous' }}</h2>
          {% if section.settings.intro != blank %}
            <p style="font-size:.9rem;color:{{ section.settings.text_color }};opacity:.65;line-height:1.75;margin-bottom:2rem;">{{ section.settings.intro }}</p>
          {% endif %}
          {% if section.settings.phone != blank %}
            <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1.25rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <a href="tel:{{ section.settings.phone }}" style="font-size:.9rem;color:{{ section.settings.text_color }};">{{ section.settings.phone }}</a>
            </div>
          {% endif %}
          {% if section.settings.email != blank %}
            <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1.25rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <a href="mailto:{{ section.settings.email }}" style="font-size:.9rem;color:{{ section.settings.text_color }};">{{ section.settings.email }}</a>
            </div>
          {% endif %}
          {% if section.settings.address != blank %}
            <div style="display:flex;align-items:flex-start;gap:.75rem;margin-bottom:1.25rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)" style="margin-top:2px;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span style="font-size:.9rem;color:{{ section.settings.text_color }};line-height:1.6;">{{ section.settings.address }}</span>
            </div>
          {% endif %}
          {% if section.settings.hours != blank %}
            <div style="display:flex;align-items:flex-start;gap:.75rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)" style="margin-top:2px;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span style="font-size:.9rem;color:{{ section.settings.text_color }};line-height:1.6;opacity:.7;">{{ section.settings.hours }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div>
        {% if section.settings.layout != 'with-info' %}
          <div style="text-align:center;margin-bottom:2.5rem;">
            {% if section.settings.overline != blank %}
              <span class="overline" style="display:block;margin-bottom:.75rem;">{{ section.settings.overline }}</span>
            {% endif %}
            <h2 style="font-family:var(--font-heading);font-size:clamp(1.8rem,3vw,2.8rem);color:{{ section.settings.text_color }};">{{ section.settings.title | default: 'Contactez-nous' }}</h2>
            {% if section.settings.intro != blank %}
              <p style="font-size:.9rem;color:{{ section.settings.text_color }};opacity:.65;line-height:1.75;max-width:500px;margin:1rem auto 0;">{{ section.settings.intro }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% form 'contact', id: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div style="background:#f0faf5;border:1px solid #a3e6c5;padding:1.25rem;margin-bottom:1.5rem;font-size:.875rem;color:#1a7a4a;text-align:center;">
              ✓ Votre message a bien été envoyé. Nous vous répondrons rapidement.
            </div>
          {% endif %}
          {% if form.errors %}
            <div style="background:#fff0f0;border:1px solid #fcc;padding:1.25rem;margin-bottom:1.5rem;font-size:.875rem;color:#b00;">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          {% assign input_style = 'width:100%;padding:.85rem 1rem;border:1px solid var(--color-border);font-family:inherit;font-size:.9rem;outline:none;background:' | append: section.settings.input_bg | append: ';color:' | append: section.settings.text_color | append: ';transition:border-color .2s;' %}
          {% assign label_style = 'display:block;font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;margin-bottom:.5rem;color:' | append: section.settings.text_color %}

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;">
            <div>
              <label style="{{ label_style }}">Prénom *</label>
              <input type="text" name="contact[first_name]" required style="{{ input_style }}">
            </div>
            <div>
              <label style="{{ label_style }}">Nom *</label>
              <input type="text" name="contact[last_name]" style="{{ input_style }}">
            </div>
          </div>

          <div style="margin-bottom:1.25rem;">
            <label style="{{ label_style }}">Email *</label>
            <input type="email" name="contact[email]" required style="{{ input_style }}">
          </div>

          {% if section.settings.show_phone %}
            <div style="margin-bottom:1.25rem;">
              <label style="{{ label_style }}">Téléphone</label>
              <input type="tel" name="contact[phone]" style="{{ input_style }}">
            </div>
          {% endif %}

          {% if section.settings.show_subject %}
            <div style="margin-bottom:1.25rem;">
              <label style="{{ label_style }}">Sujet</label>
              <select name="contact[subject]" style="{{ input_style }}appearance:none;">
                <option>Demande d'information</option>
                <option>Devis sur mesure</option>
                <option>Service après-vente</option>
                <option>Visite du showroom</option>
                <option>Autre</option>
              </select>
            </div>
          {% endif %}

          <div style="margin-bottom:1.75rem;">
            <label style="{{ label_style }}">Message *</label>
            <textarea name="contact[body]" required rows="{{ section.settings.textarea_rows }}" style="{{ input_style }}resize:vertical;"></textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--full btn--large">{{ section.settings.btn_text | default: 'Envoyer le message' }}</button>
        {% endform %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Nous contacter" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Parlons de votre projet" },
    { "type": "textarea", "id": "intro", "label": "Texte d'introduction" },
    {
      "type": "header",
      "content": "Mise en page"
    },
    { "type": "select", "id": "layout", "label": "Disposition", "options": [{"value":"centered","label":"Centré (formulaire seul)"},{"value":"with-info","label":"Avec infos de contact"}], "default": "with-info" },
    {
      "type": "header",
      "content": "Informations de contact (si disposition avec infos)"
    },
    { "type": "text", "id": "phone", "label": "Téléphone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "textarea", "id": "address", "label": "Adresse" },
    { "type": "textarea", "id": "hours", "label": "Horaires" },
    {
      "type": "header",
      "content": "Champs du formulaire"
    },
    { "type": "checkbox", "id": "show_phone", "label": "Champ téléphone", "default": true },
    { "type": "checkbox", "id": "show_subject", "label": "Champ sujet", "default": true },
    { "type": "range", "id": "textarea_rows", "min": 3, "max": 10, "step": 1, "default": 5, "label": "Lignes du message" },
    { "type": "text", "id": "btn_text", "label": "Texte du bouton", "default": "Envoyer le message" },
    {
      "type": "header",
      "content": "Couleurs"
    },
    { "type": "color", "id": "bg_color", "label": "Fond de section", "default": "#ffffff" },
    { "type": "color", "id": "input_bg", "label": "Fond des champs", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#1a1a1a" },
    { "type": "range", "id": "padding_top", "min": 2, "max": 12, "step": 1, "default": 5, "label": "Espacement haut", "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "min": 2, "max": 12, "step": 1, "default": 5, "label": "Espacement bas", "unit": "rem" }
  ],
  "presets": [
    {
      "name": "Formulaire de contact",
      "settings": {
        "title": "Parlons de votre projet",
        "overline": "Nous contacter",
        "layout": "with-info"
      }
    }
  ]
}
{% endschema %}
