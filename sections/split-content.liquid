<section class="split-section{% if section.settings.reverse %} split-section--reverse{% endif %}">

  <div class="split-media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {% else %}
      <div style="background:var(--color-surface);width:100%;height:100%;min-height:500px;"></div>
    {% endif %}
  </div>

  <div class="split-content{% if section.settings.dark_bg %} split-content--dark{% endif %}">
    {% if section.settings.overline != blank %}
      <span class="overline split-content__overline">{{ section.settings.overline }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="split-content__title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="split-content__text">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="split-content__features">
        {% for block in section.blocks %}
          <div class="split-feature">
            <div class="split-feature__icon">
              {% case block.settings.icon %}
                {% when 'check' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {% when 'star' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                {% when 'truck' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              {% endcase %}
            </div>
            <div>
              <div class="split-feature__title">{{ block.settings.title }}</div>
              <div class="split-feature__desc">{{ block.settings.description }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_url }}" class="btn{% if section.settings.dark_bg %} btn--secondary{% else %} btn--outline{% endif %}">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>

</section>

{% schema %}
{
  "name": "Contenu divisé",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "overline", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'Excellence du Mobilier Italien" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Chaque pièce Italia Design est le fruit d'un savoir-faire exceptionnel, alliant les traditions artisanales italiennes à une vision contemporaine du luxe.</p>" },
    { "type": "text", "id": "btn_text", "label": "Bouton texte", "default": "Notre Histoire" },
    { "type": "url", "id": "btn_url", "label": "Bouton lien" },
    { "type": "checkbox", "id": "reverse", "label": "Inverser l'ordre", "default": false },
    { "type": "checkbox", "id": "dark_bg", "label": "Fond sombre", "default": false }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caractéristique",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [{"value":"check","label":"Coche"},{"value":"star","label":"Étoile"},{"value":"truck","label":"Livraison"},{"value":"bolt","label":"Éclair"}], "default": "check" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Qualité Premium" },
        { "type": "text", "id": "description", "label": "Description", "default": "Matériaux sélectionnés avec soin" }
      ]
    }
  ],
  "presets": [{
    "name": "Contenu divisé",
    "blocks": [
      { "type": "feature", "settings": { "icon": "check", "title": "Artisanat Exceptionnel", "description": "Chaque pièce est fabriquée à la main par des artisans experts" } },
      { "type": "feature", "settings": { "icon": "truck", "title": "Livraison & Montage", "description": "Service de livraison et d'installation dans tout le Maroc" } },
      { "type": "feature", "settings": { "icon": "star", "title": "Garantie 5 ans", "description": "Tous nos meubles sont couverts par une garantie fabricant" } }
    ]
  }]
}
{% endschema %}
