<section style="background:{{ section.settings.bg_color }};padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;">

  <div style="display:grid;grid-template-columns:{% if section.settings.image_width == 'wide' %}3fr 2fr{% elsif section.settings.image_width == 'narrow' %}2fr 3fr{% else %}1fr 1fr{% endif %};min-height:{{ section.settings.min_height }}px;{% if section.settings.contained %}max-width:1440px;margin:0 auto;{% endif %}">

    <div style="order:{% if section.settings.reverse %}2{% else %}1{% endif %};position:relative;overflow:hidden;min-height:{{ section.settings.min_height }}px;">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading, style: 'width:100%;height:100%;object-fit:cover;object-position:' | append: section.settings.image_position | append: ';' }}
      {% else %}
        <div style="background:var(--color-surface);width:100%;height:100%;min-height:{{ section.settings.min_height }}px;"></div>
      {% endif %}
    </div>

    <div style="order:{% if section.settings.reverse %}1{% else %}2{% endif %};display:flex;flex-direction:column;justify-content:{{ section.settings.content_align }};padding:{{ section.settings.content_padding }}rem;background:{{ section.settings.content_bg }};color:{{ section.settings.content_text_color }};">

      {% if section.settings.overline != blank %}
        <span class="overline" style="color:var(--color-accent);display:block;margin-bottom:1rem;">{{ section.settings.overline }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 style="font-family:var(--font-heading);font-size:clamp(1.6rem,3vw,{{ section.settings.heading_size }}px);font-weight:400;margin-bottom:1.25rem;line-height:1.2;color:{{ section.settings.content_text_color }};">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div style="font-size:.9rem;line-height:1.8;margin-bottom:2rem;opacity:.8;">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div style="display:flex;flex-direction:column;gap:1.25rem;margin-bottom:2rem;">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div style="display:flex;align-items:flex-start;gap:1rem;" {{ block.shopify_attributes }}>
                <div style="width:36px;height:36px;border:1px solid rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:{{ section.settings.content_text_color }};">
                  {% case block.settings.icon %}
                    {% when 'check' %}<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {% when 'star' %}<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    {% when 'truck' %}<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
                    {% else %}<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  {% endcase %}
                </div>
                <div>
                  <div style="font-size:.8rem;font-weight:700;letter-spacing:.05em;margin-bottom:.2rem;color:{{ section.settings.content_text_color }};">{{ block.settings.title }}</div>
                  <div style="font-size:.8rem;opacity:.7;color:{{ section.settings.content_text_color }};">{{ block.settings.description }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.btn_text != blank %}
        <div>
          <a href="{{ section.settings.btn_url }}" class="btn btn--{{ section.settings.btn_style }}">{{ section.settings.btn_text }}</a>
        </div>
      {% endif %}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Contenu divisé",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Position de l'image", "options": [{"value":"center","label":"Centre"},{"value":"top","label":"Haut"},{"value":"bottom","label":"Bas"},{"value":"left","label":"Gauche"},{"value":"right","label":"Droite"}], "default": "center" },
    { "type": "select", "id": "image_width", "label": "Largeur de l'image", "options": [{"value":"equal","label":"Égale (50/50)"},{"value":"wide","label":"Large (60/40)"},{"value":"narrow","label":"Étroite (40/60)"}], "default": "equal" },
    {
      "type": "header",
      "content": "Contenu texte"
    },
    { "type": "text", "id": "overline", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'Excellence du Mobilier Italien" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 56, "step": 2, "default": 40, "label": "Taille du titre", "unit": "px" },
    { "type": "richtext", "id": "text", "label": "Texte descriptif", "default": "<p>Chaque pièce Italia Design est le fruit d'un savoir-faire exceptionnel, alliant les traditions artisanales italiennes à une vision contemporaine du luxe.</p>" },
    { "type": "text", "id": "btn_text", "label": "Bouton — Texte" },
    { "type": "url", "id": "btn_url", "label": "Bouton — Lien" },
    { "type": "select", "id": "btn_style", "label": "Style du bouton", "options": [{"value":"outline","label":"Contour sombre"},{"value":"primary","label":"Plein sombre"},{"value":"secondary","label":"Contour clair"}], "default": "outline" },
    {
      "type": "header",
      "content": "Mise en page"
    },
    { "type": "checkbox", "id": "reverse", "label": "Image à droite", "default": false },
    { "type": "checkbox", "id": "contained", "label": "Limiter la largeur", "default": false },
    { "type": "range", "id": "min_height", "min": 300, "max": 800, "step": 50, "default": 500, "label": "Hauteur minimale", "unit": "px" },
    { "type": "range", "id": "content_padding", "min": 2, "max": 8, "step": 1, "default": 5, "label": "Padding contenu", "unit": "rem" },
    { "type": "select", "id": "content_align", "label": "Alignement vertical contenu", "options": [{"value":"center","label":"Centré"},{"value":"flex-start","label":"Haut"},{"value":"flex-end","label":"Bas"}], "default": "center" },
    {
      "type": "header",
      "content": "Couleurs"
    },
    { "type": "color", "id": "bg_color", "label": "Fond de section", "default": "#ffffff" },
    { "type": "color", "id": "content_bg", "label": "Fond du contenu texte", "default": "#f8f8f8" },
    { "type": "color", "id": "content_text_color", "label": "Couleur du texte", "default": "#1a1a1a" },
    {
      "type": "header",
      "content": "Espacement"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 12, "step": 1, "default": 0, "label": "Espacement haut", "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 12, "step": 1, "default": 0, "label": "Espacement bas", "unit": "rem" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caractéristique",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [{"value":"check","label":"✓ Coche"},{"value":"star","label":"★ Étoile"},{"value":"truck","label":"🚚 Livraison"},{"value":"bolt","label":"⚡ Éclair"}], "default": "check" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Qualité Premium" },
        { "type": "text", "id": "description", "label": "Description", "default": "Matériaux sélectionnés avec soin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contenu divisé",
      "settings": { "heading": "L'Excellence du Mobilier Italien" },
      "blocks": [
        { "type": "feature", "settings": { "icon": "check", "title": "Artisanat Exceptionnel", "description": "Fabriqué à la main par des artisans experts" } },
        { "type": "feature", "settings": { "icon": "truck", "title": "Livraison & Montage", "description": "Service complet dans tout le Maroc" } },
        { "type": "feature", "settings": { "icon": "star", "title": "Garantie 5 Ans", "description": "Tous nos meubles sont garantis fabricant" } }
      ]
    }
  ]
}
{% endschema %}
